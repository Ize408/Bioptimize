# copy to .env and fill in. .env is ignored by git, never commit your keys

THINGSPEAK_WRITE_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_SENDER=
TWILIO_PHONE_RECIPIENT=

# relay pins, BCM numbering
RELAY_ADD_PH=23
RELAY_SUBTRACT_PH=24
RELAY_MOTOR=8
RELAY_ACTIVE_LOW=0

# DS18B20 ids, check with: ls /sys/bus/w1/devices/
SLUDGE_SENSOR_ID=
GAS_SENSOR_ID=

ADS1115_ADDRESS=0x49

# pH calibration (mV in pH 4 and pH 7 buffer)
PH_ACID_VOLTAGE=3154
PH_NEUTRAL_VOLTAGE=2540

PH_SAFE_MIN=6.5
PH_SAFE_MAX=7.5
PH_TOLERANCE=0.2

SLUDGE_TEMP_ALERT=50
GAS_ALERT=90000
